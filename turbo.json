{
	"$schema": "https://turbo.build/schema.json",
	"envMode": "loose",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {},
		"e2e": {
			"cache": false
		}
	}
}
